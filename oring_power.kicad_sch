			)
			(justify left top)
		)
		(uuid "8b5a5cc0-a7f3-401c-bf1d-500838705c71")
	)
	(text_box "These NOTIFY signals are logic-only indicators and not analog measurements. They will allow the RP2040 to determine which USB ports are being used (one, the other or both together). "
		(exclude_from_sim no)
		(at 30.48 71.12 0)
		(size 29.21 19.05)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "f056d1cb-2c81-4c8e-8c71-10be1d09fe22")
	)
